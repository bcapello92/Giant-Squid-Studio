.enemy-health-root {
    position: absolute;
    width: 60px;
    height: 8px;
}

.enemy-health-bar {
    width: 100%;
    height: 100%;
    border-radius: 3px;
    overflow: hidden;
}

/* black background */
.enemy-health-bar .unity-progress-bar__background {
    background-color: rgb(0, 0, 0);
}

/* red fill */
.enemy-health-bar .unity-progress-bar__progress {
    background-color: rgb(200, 40, 40);
}

/* no text */
.enemy-health-bar .unity-progress-bar__title {
    display: none;
}
