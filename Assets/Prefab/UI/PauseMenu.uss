#pause-root {
using System.Drawing;
using System.Reflection;
using UnityEngine;
using UnityEngine.UIElements;

width: 100 %;
height: 100 %;
justify - content: center;
align - items: center;
}

#background {
    width: 60 %;
height: 60 %;
background - color: rgba(0, 0, 0, 0.6);
border - radius: 12px;
flex - direction: column;
justify - content: center;
align - items: center;
gap: 20px;
}

#pause-title {
    color: white;
font - size: 32px;
unity - text - align: middle;
}

Button {
    width: 200px;
height: 45px;
font - size: 18px;
color: white;
background - color: rgba(255, 255, 255, 0.1);
border - radius: 8px;
}

Button: hover {
    background - color: rgba(255, 255, 255, 0.25);
}
