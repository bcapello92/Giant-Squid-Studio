            <ui:Button name="restart-btn" text="Restart Run" class="menu-btn" style="background-size: 25% 100%; height: 42px; width: 220px; align-self: center;" />
            <ui:Button name="quit-btn" text="Quit Game" class="menu-btn" style="background-size: 25% 25%; -unity-background-image-tint-color: rgb(118, 118, 118); height: 44px; width: 197px; align-items: center; align-self: center;" />
        </ui:VisualElement>
