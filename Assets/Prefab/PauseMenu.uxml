<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/Prefab/GameOver.uss?fileID=7433441132597879392&amp;guid=4717058c07ea8bb42a7b4e7f4cefa133&amp;type=3#GameOver" />
    <Style src="project://database/Assets/Scenes/TitleScreenImages/GameTitle.uss?fileID=7433441132597879392&amp;guid=bdbfd4534faa35841bd2606be2cb391f&amp;type=3#GameTitle" />
    <ui:VisualElement name="pause-root" class="root" style="height: 450px; width: 346px; background-color: rgba(43, 35, 35, 0.43); flex-direction: column; max-width: 100%; max-height: 100%; min-width: 100%; min-height: 100%;">
        <ui:VisualElement name="scrim" class="scrim" />
