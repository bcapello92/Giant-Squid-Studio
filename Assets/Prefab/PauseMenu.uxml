<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <ui:VisualElement name="pause-root" class="root">
        <ui:VisualElement name="scrim" class="scrim" />
        <ui:VisualElement name="panel" class="panel">
            <ui:Label name="pause-title" text="PAUSED" class="title" />
            <ui:Button name="resume-btn" text="Resume Game" style="background-size: 25% 25%; height: 37px; width: 111px; align-self: center;" />
            <ui:Button name="menu-btn" text="Return to Menu" style="height: 42px; background-size: 25% 100%; width: 127px; align-self: center;" />
            <ui:Button name="restart-btn" text="Restart Run" style="background-size: 25% 100%; height: 42px; width: 88px; align-self: center;" />
        </ui:VisualElement>
        <ui:Button name="quit-btn" text="Quit Game" style="background-size: 25% 25%; -unity-background-image-tint-color: rgb(118, 118, 118); height: 44px; width: 92px; align-items: center; align-self: center;" />
    </ui:VisualElement>
</ui:UXML>
